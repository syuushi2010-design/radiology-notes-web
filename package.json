{
  "name": "radiology-notes-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "validate:deploy": "node scripts/validate-production-env.mjs",
    "check:public": "node scripts/check-public-build.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:public",
    "test:watch": "vitest",
    "sync:note": "node --env-file=.env.local scripts/sync-note.mjs",
    "backup:export": "node --env-file=.env.local scripts/export-notes.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "fuse.js": "7.5.0",
    "lucide-react": "1.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.2",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
